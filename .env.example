DATABASE_URL=sqlite+pysqlite:///./linkedin_content.db
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Qwen — human writing
WRITER_MODEL=qwen3:8b
HUMANIZER_MODEL=qwen3:8b

# DeepSeek — reasoning / analysis / criticism
# Use alias "deepseek" (resolves to DEEPSEEK_MODEL) or a concrete Ollama tag.
DEEPSEEK_MODEL=deepseek-r1:7b
RESEARCH_MODEL=deepseek
INSIGHT_MODEL=deepseek
CRITIC_MODEL=deepseek
PREDICTOR_MODEL=deepseek

# Optional stage overrides:
# TREND_MODEL=deepseek
# ANGLE_MODEL=deepseek
# STRATEGIST_MODEL=deepseek
# WRITING_QUALITY_MODEL=deepseek

DEBATE_MODE=true
OLLAMA_THINK=false
OLLAMA_NUM_CTX=4096
USER_MEMORY_PATH=knowledge/user_memory.json
CONTENT_MODES_PATH=knowledge/content_modes.json
ENGAGEMENT_FEEDBACK_PATH=feedback/engagement_feedback.json
RESEARCH_SOURCES_DIR=research_sources
USE_FAKE_PROVIDER=false

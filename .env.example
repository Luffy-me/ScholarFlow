DATABASE_URL=sqlite+pysqlite:///./linkedin_content.db

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# Qwen — human writing
WRITER_MODEL=qwen3:8b
HUMANIZER_MODEL=qwen3:8b

# DeepSeek — reasoning / analysis / criticism
DEEPSEEK_MODEL=deepseek-r1:8b
RESEARCH_MODEL=deepseek-r1:8b
INSIGHT_MODEL=deepseek-r1:8b
CRITIC_MODEL=deepseek-r1:8b
PREDICTOR_MODEL=deepseek-r1:8b

OLLAMA_THINK=false
OLLAMA_NUM_CTX=4096
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_GENERATION_TIMEOUT=300
OLLAMA_MAX_RETRIES=2

API_PORT=8000
FRONTEND_PORT=3000

DEBATE_MODE=true
USER_MEMORY_PATH=knowledge/user_memory.json
CONTENT_MODES_PATH=knowledge/content_modes.json
ENGAGEMENT_FEEDBACK_PATH=feedback/engagement_feedback.json
RESEARCH_SOURCES_DIR=research_sources
USE_FAKE_PROVIDER=false

# Web UI (Next.js) — API proxy target for /backend/*
SCHOLARFLOW_API_URL=http://127.0.0.1:8000
